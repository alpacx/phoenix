CONFIG_PHOENIX_GATEWAY_BENCH=y
CONFIG_PHOENIX_USB_LAB=n
CONFIG_PHOENIX_C6_PROBE=n
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=63360
CONFIG_LWIP_TCP_WND_DEFAULT=63360
CONFIG_LWIP_TCP_RECVMBOX_SIZE=46
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ETH_DMA_BUFFER_SIZE=1536
CONFIG_ETH_DMA_RX_BUFFER_NUM=30
CONFIG_ETH_DMA_TX_BUFFER_NUM=10

CONFIG_LWIP_IPV4_NAPT_PORTMAP=y

CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 44 MSS (1440) window; no window scaling required.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=63360
CONFIG_LWIP_TCP_WND_DEFAULT=63360
CONFIG_LWIP_TCP_RECVMBOX_SIZE=46
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192
CONFIG_LWIP_IPV6=n

# IDF 5.5: keep esp_netif client data separate from WireGuard netif->state.
CONFIG_LWIP_PPP_SUPPORT=y

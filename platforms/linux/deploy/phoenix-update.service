[Unit]
Description=Activate signed Phoenix application release
Requires=phoenix-update-recover.service
After=phoenix-update-recover.service
ConditionPathExists=/etc/phoenix/updates.json

[Service]
Type=oneshot
ExecStart=/opt/phoenix-bootstrap/bin/phoenix update activate
ExecStopPost=/opt/phoenix-bootstrap/bin/phoenix update recover --restart
TimeoutStartSec=300
TimeoutStopSec=150
UMask=0077

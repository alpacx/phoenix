[Unit]
Description=Phoenix privileged gateway controller
After=network-online.target phoenix-update-recover.service
Wants=network-online.target phoenix-update-recover.service

[Service]
Type=simple
Group=phoenix-web
WorkingDirectory=/opt/phoenix
ExecStart=/opt/phoenix/bin/phoenix control --state-dir /var/lib/phoenix --target-config /etc/phoenix/target.json --worker-socket /run/phoenix-control/control.sock
# Guard from the install-time bootstrap copy: a broken release must still fail closed.
ExecStopPost=/opt/phoenix-bootstrap/bin/phoenix stop-guard
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=phoenix
StateDirectoryMode=0700
RuntimeDirectory=phoenix phoenix-control
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/phoenix /run/phoenix /proc/sys/net/ipv4/ip_forward -/opt/phoenix-releases -/run/NetworkManager/system-connections
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
